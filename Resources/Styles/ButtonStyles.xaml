<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Resources.Styles.ButtonStyles">

    <Style TargetType="Button" x:Key="TileButton">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BackgroundColor" Value="#ff4000"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="BorderColor" Value="Black"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
    
    <Style TargetType="Button" x:Key="TileButtonTypeTwo">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BackgroundColor" Value="#A2B06D"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="BorderColor" Value="Black"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>

    <Style TargetType="Button" x:Key="TileButtonTypeThree">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BackgroundColor" Value="#FFA500"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="BorderColor" Value="Black"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>

    <Style TargetType="Button" x:Key="TileButtonTypeFour">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BackgroundColor" Value="#FFC1CC"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="BorderColor" Value="Black"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>

    <Style TargetType="Button" x:Key="TileButtonTypeFive">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="BorderColor" Value="Black"/>
        <Setter Property="CornerRadius" Value="15"/>
    </Style>

</ResourceDictionary>