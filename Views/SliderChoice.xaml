<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.SliderChoice"
             Title="{Binding Title}">
    
    <VerticalStackLayout>

        <Grid Margin="25, 35, 20, 20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TitleXamlSlider}"
                    Style="{StaticResource TileButtonTypeFour}"
                    Command="{Binding XamlSliderClickedCommand}"/>

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TitleVmSlider}"
                    Style="{StaticResource TileButtonTypeFour}"
                    Command="{Binding VmSliderClickedCommand}"/>
            
        </Grid>
        
       </VerticalStackLayout>
            
</ContentPage>