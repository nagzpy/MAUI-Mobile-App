<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyFirstMAUIMobileApp.Views.SliderPage"
    Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="20">

        <!-- Name this so we can fade it in code -->
        <BoxView Color="Blue"
                 HeightRequest="25" 
                 HorizontalOptions="Fill" />

        <!-- Hook the ValueChanged event -->
        <Slider Minimum="0" Maximum="1" Value="1"
                ThumbColor="Blue" MaximumTrackColor="BlueViolet" MinimumTrackColor="DarkOrange"
                HorizontalOptions="Fill"
                ValueChanged="OnSliderValueChanged" />

        <!-- This label shows the numeric value -->
        <Label FontAttributes="Bold" 
               FontSize="Large" 
               HorizontalOptions="Center" />

        <!-- Name and fade this one too -->
        <Label Text="Moving Slider Will Change Opacity"
               FontAttributes="Bold" FontSize="Medium" TextColor="Blue"
               HorizontalOptions="Center" />

    </VerticalStackLayout>
    
</ContentPage>
