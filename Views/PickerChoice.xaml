<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.PickerChoice"
             Title="Picker Menu">
    <VerticalStackLayout>
        <ImageButton Source="buttonred.png"
               HeightRequest="200"
               WidthRequest="200"
               HorizontalOptions="Center" 
               Command="{Binding PickerXamlClickedCommand}"/>
        <ImageButton Source="buttonblue.png"
               HeightRequest="200"
               WidthRequest="200"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>