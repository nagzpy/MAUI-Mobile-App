<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.LayoutsAbsolutePage"
             Title="{Binding Title}">

    <AbsoluteLayout>

        <Label Text="Absolute!" 
               FontSize="25"
               FontAttributes="Bold"
               AbsoluteLayout.LayoutFlags="PositionProportional"
               AbsoluteLayout.LayoutBounds="0.5, 0"/>

        <BoxView Color="#008000"
                 AbsoluteLayout.LayoutBounds="0.05, 0.2, 0.1829, .06"
                 AbsoluteLayout.LayoutFlags="All"/>

        <BoxView Color="#dc143d"
                 AbsoluteLayout.LayoutBounds="0.33, 0.2, 0.1829, .06"
                 AbsoluteLayout.LayoutFlags="All"/>

        <BoxView Color="#ffe4c4"
                 AbsoluteLayout.LayoutBounds="0.66, 0.2, 0.1829, .06"
                 AbsoluteLayout.LayoutFlags="All"/>

        <BoxView Color="#ffe4c4"
                 AbsoluteLayout.LayoutBounds="0.95, 0.2, 0.1829, .06"
                 AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>    

</ContentPage>