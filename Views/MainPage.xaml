<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.MainPage"
             Title="{Binding Title}">

    <VerticalStackLayout>
        
        <Grid Margin="25, 35, 20, 20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding TitleButtonLayouts}" 
                    Style="{StaticResource TileButton}"
                    Command="{Binding LayoutsClickedCommand}"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding TitleButtonImages}"
                    Style="{StaticResource TileButton}"
                    Command="{Binding ImagesClickedCommand}"/>

            <Button Text="{Binding TitleButtonCollections}"
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource TileButton}"
                Command="{Binding CollectionsClickedCommand}"/>

            <Button Text="{Binding TitleButtonControls}" 
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource TileButton}"
                Command="{Binding ControlsClickedCommand}"/>

            <Button Text="{Binding TitleButtonSQLLite}" 
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Style="{StaticResource TileButton}"/>
            
        </Grid>
        
    </VerticalStackLayout>
    
</ContentPage>