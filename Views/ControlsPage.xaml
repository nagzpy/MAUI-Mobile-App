<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.ControlsPage"
             Title="{Binding Title}">
    
    <VerticalStackLayout>

        <Grid Margin="25, 35, 20, 20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding TitleSlider}"
                    Style="{StaticResource TileButtonTypeFour}"
                    Command="{Binding SliderClickedCommand}"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding TitleStepper}"
                    Style="{StaticResource TileButtonTypeFour}"/>

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding TitleSwitch}"
                    Style="{StaticResource TileButtonTypeFour}"/>

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding TitleEntry}"
                    Style="{StaticResource TileButtonTypeFour}"/>

            <Button Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TitlePicker}"
                    Style="{StaticResource TileButtonTypeFour}"/>

            <Button Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TitleDateTime}"
                    Style="{StaticResource TileButtonTypeFour}"/>

        </Grid>

    </VerticalStackLayout>
    
</ContentPage>