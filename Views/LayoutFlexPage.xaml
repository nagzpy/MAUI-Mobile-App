<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.LayoutFlexPage"
             Title="{Binding Title}">
    <VerticalStackLayout VerticalOptions="Center">
        <FlexLayout Direction="Row"
                    JustifyContent="SpaceAround"
                    AlignItems="Center"
                    BackgroundColor="White">

            <BoxView Color="Red"
                     HeightRequest="50"
                     WidthRequest="50"/>

            <BoxView Color="Green"
                     HeightRequest="50"
                     WidthRequest="50"/>

            <BoxView Color="Blue"
                     HeightRequest="50"
                     WidthRequest="50"/>
            
        </FlexLayout>
        <VerticalStackLayout>
        <Label Text="Red"
               Margin="45, 15, 0, 0"/>
        <Label Text="Green"
               Margin="185, 0, 0, 0"/>
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentPage>