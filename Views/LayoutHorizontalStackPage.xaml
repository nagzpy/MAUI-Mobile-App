<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.LayoutHorizontalStackPage"
             Title="{Binding Title}">
    
    <VerticalStackLayout Spacing="20" Padding="20">

        <HorizontalStackLayout>
            <BoxView BackgroundColor="Red" WidthRequest="100" HeightRequest="100"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center">
            <BoxView BackgroundColor="Green" WidthRequest="100" HeightRequest="100"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout VerticalOptions="Center">
            <BoxView BackgroundColor="Blue" WidthRequest="100" HeightRequest="100"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="End">
            <BoxView BackgroundColor="Purple" WidthRequest="100" HeightRequest="100"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
    
</ContentPage>