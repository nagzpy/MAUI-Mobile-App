<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.StepperChoice"
             Title="{Binding Title}">

    <VerticalStackLayout>

        <Grid Margin="25, 35, 20, 20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TitleXamlStepper}"
                    Style="{StaticResource TileButtonTypeFour}"
                    Command="{Binding XamlStepperClickedCommand}"/>

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TitleVmStepper}"
                    Style="{StaticResource TileButtonTypeFour}"
                    Command="{Binding VmStepperClickedCommand}"/>

        </Grid>

    </VerticalStackLayout>

</ContentPage>