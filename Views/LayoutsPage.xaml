<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIMobileApp.Views.LayoutsPage"
             Title="{Binding Title}">
    
    <VerticalStackLayout>

        <Grid Margin="25, 35, 20, 20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TitleButtonStackLayout}" 
                    Style="{StaticResource TileButtonTypeTwo}"
                    Command="{Binding LayoutStackClickedCommand}"/>

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding TitleButtonVerticalStack}"
                    Style="{StaticResource TileButtonTypeTwo}"
                    Command="{Binding LayoutVerticalStackClickedCommand}"/>

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding TitleButtonHorizontalStack}"
                    Style="{StaticResource TileButtonTypeTwo}"
                    Command="{Binding LayoutHorizontalStackClickedCommand}"/>

            <Button Grid.Row="2"
                    Grid.Column="0"
                    Text="{Binding TitleButtonAbsoluteLayout}"
                    Style="{StaticResource TileButtonTypeTwo}"
                    Command="{Binding LayoutAbsoluteClickedCommand}"/>
            
            <Button Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding TitleButtonFlexLayout}"
                    Style="{StaticResource TileButtonTypeTwo}"
                    Command="{Binding LayoutFlexClickedCommand}"/>

        </Grid>

    </VerticalStackLayout>
    
</ContentPage>